{
  "name": "arcus-next",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/arcus-core"
  ],
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key certs/key.pem --experimental-https-cert certs/cert.pem --hostname localdev.myDevUrl.com --port 8443",
    "dev:e2e": "NEXT_PUBLIC_API_URL=http://localhost:3000 NEXT_PUBLIC_WS_URL=ws://localhost:3000 NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000 next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:ci": "start-server-and-test dev:e2e http://localhost:3000 test:e2e"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.4.2",
    "partysocket": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cypress": "^15.11.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.4.49",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.0"
  }
}
