exports[`S2PinPrompt – typing the PIN matches snapshot when the attempt is spent 1`] = `
<DocumentFragment>
  <div
    class="fixed inset-0 bg-swift/30 flex items-center justify-center z-50 p-4"
  >
    <div
      aria-labelledby="s2-pin-title"
      aria-modal="true"
      class="bg-crane rounded-[var(--border-radius-lg)] border border-heron p-6 w-full max-w-md shadow-lg max-h-full overflow-y-auto"
      data-phase="spent"
      data-testid="s2-pin-prompt"
      role="dialog"
    >
      <div
        class="flex items-start justify-between gap-3 mb-3"
      >
        <h3
          class="text-lg font-semibold text-swift"
          id="s2-pin-title"
        >
          Secure this Z-Wave device
        </h3>
      </div>
      <p
        class="text-sm text-coot mb-4"
        data-testid="s2-pin-spent"
        role="alert"
      >
        The hub didn't take the PIN. There is only one try per pairing, so the device will join without S2 security. Exclude or factory reset it, then pair it again to secure it.
      </p>
      <button
        class="flex-1 py-2 rounded-[var(--border-radius-base)] text-sm font-medium bg-peacock text-crane hover:bg-peacock/90 w-full"
        data-testid="s2-pin-close"
        type="button"
      >
        Close
      </button>
    </div>
  </div>
</DocumentFragment>
`;
