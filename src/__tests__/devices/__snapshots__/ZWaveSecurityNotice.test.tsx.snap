exports[`ZWaveSecurityNotice matches snapshot for an S0 downgrade 1`] = `
<DocumentFragment>
  <div
    class="text-sm p-3 border border-cardinal bg-cardinal/5 rounded-[var(--border-radius-base)] "
    data-testid="zwave-security-s0-downgrade"
    role="alert"
  >
    <p
      class="font-semibold text-swift mb-1"
    >
      Security downgraded to S0 (legacy)
    </p>
    <p
      class="text-coot"
    >
      This device supports S2 Access Control but joined with S0 (legacy) only. That can happen when something interferes with the secure key exchange. Remove the device and pair it again. If it happens again, check for other Z-Wave controllers nearby before relying on this device.
    </p>
  </div>
</DocumentFragment>
`;
