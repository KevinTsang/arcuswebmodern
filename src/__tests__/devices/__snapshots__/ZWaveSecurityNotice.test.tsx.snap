exports[`ZWaveSecurityNotice matches snapshot for a downgrade within S2 1`] = `
<DocumentFragment>
  <p
    class="text-sm text-swift bg-pigeon border border-heron rounded-[var(--border-radius-base)] p-3 "
    data-testid="device-security-downgraded"
    role="alert"
  >
