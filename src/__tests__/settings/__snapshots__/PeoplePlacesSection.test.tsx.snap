        class="px-4 py-2 bg-peacock text-crane rounded-[var(--border-radius-base)] text-sm font-medium hover:bg-peacock/90 disabled:opacity-50"
        data-testid="add-place"
        disabled=""
      >
        + Add Place
      </button>
      <p
        class="text-xs text-grouse"
        data-testid="add-place-hint"
      >
        To add your own place, create a new account using a different email address.
      </p>
    </div>
  </div>
</DocumentFragment>
`;
